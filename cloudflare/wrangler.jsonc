{
  "name": "creative-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 database (already created)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creative-agent-db",
      "database_id": "ddcd29d7-632c-4017-8f3b-9de6cdd8c5fe"
    }
  ],

  // R2 bucket (already created)
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "creative-agent-assets"
    }
  ],

  // Sandbox container (runs Claude SDK)
  "containers": [{
    "class_name": "Sandbox",
    "image": "./sandbox/Dockerfile",
    "instance_type": "standard-1",
    "max_instances": 10
  }],

  // Durable Objects (Phase 3 + Phase 4 Sandbox)
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMPAIGN_SESSION",
        "class_name": "CampaignSession"
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox"
      }
    ]
  },

  // DO migrations
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CampaignSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    }
  ]
}
