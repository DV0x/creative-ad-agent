{
  "name": "creative-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Place Worker near US East — Anthropic API is US-hosted (avoids geo-blocked IP ranges)
  "placement": {
    "region": "aws:us-east-1"
  },

  // D1 database (already created)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creative-agent-db",
      "database_id": "ddcd29d7-632c-4017-8f3b-9de6cdd8c5fe"
    }
  ],

  // R2 bucket (already created)
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "creative-agent-assets"
    }
  ],

  // Sandbox container (runs Claude SDK — needs 1 vCPU + 6GB for CLI + subagents)
  "containers": [{
    "class_name": "Sandbox",
    "image": "./sandbox/Dockerfile",
    "instance_type": "standard-2",
    "max_instances": 50
  }],

  // Durable Objects (Phase 3 + Phase 4 Sandbox)
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMPAIGN_SESSION",
        "class_name": "CampaignSession"
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox"
      }
    ]
  },

  // DO migrations
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CampaignSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    }
  ],

  // Static assets — serves React client from same origin
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Container observability (enables container logs in dashboard)
  "observability": {
    "enabled": true
  },

  // NOTE: WebSocket transport (SANDBOX_TRANSPORT=websocket) has a hardcoded 120s
  // stream timeout that kills waitForLog prematurely. Stick with HTTP (default).
  // R2 alarm polling is the safety net for silent HTTP SSE hangs.

  // --- Environments ---

  "env": {
    // Local dev (wrangler dev --env dev)
    "dev": {
      "vars": {
        "AI_BACKEND": "local"
      }
    },

    // Staging: uses existing DB/R2, Clerk test keys
    // Deploy: npx wrangler deploy --env staging
    // URL: creative-agent-staging.alphasapien17.workers.dev
    "staging": {
      "name": "creative-agent-staging",
      "vars": {
        "R2_BUCKET_NAME": "creative-agent-assets"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "creative-agent-db",
          "database_id": "ddcd29d7-632c-4017-8f3b-9de6cdd8c5fe"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "creative-agent-assets"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "CAMPAIGN_SESSION", "class_name": "CampaignSession" },
          { "name": "SANDBOX", "class_name": "Sandbox" }
        ]
      },
      "containers": [{
        "class_name": "Sandbox",
        "image": "./sandbox/Dockerfile",
        "instance_type": "standard-2",
        "max_instances": 50
      }]
    },

    // Production: fresh DB/R2, Clerk live keys, custom domain
    // Deploy: npx wrangler deploy --env production
    // URL: creativemachines.xyz
    "production": {
      "name": "creative-agent-production",
      "vars": {
        "R2_BUCKET_NAME": "creative-agent-assets-prod"
      },
      "routes": [
        {
          "pattern": "creativemachines.xyz/*",
          "zone_name": "creativemachines.xyz"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "creative-agent-db-prod",
          "database_id": "8128f3b2-e5ba-4375-a601-825d400b259d"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "creative-agent-assets-prod"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "CAMPAIGN_SESSION", "class_name": "CampaignSession" },
          { "name": "SANDBOX", "class_name": "Sandbox" }
        ]
      },
      "containers": [{
        "class_name": "Sandbox",
        "image": "./sandbox/Dockerfile",
        "instance_type": "standard-2",
        "max_instances": 50
      }]
    }
  }
}
