<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI PM Eval Masterclass v2</title>
<style>
  :root {
    --coral: #E8553A;
    --coral-light: #FDEEEB;
    --coral-dark: #C4402A;
    --ink: #1a1a1a;
    --ink-light: #4a4a4a;
    --ink-muted: #8a8a8a;
    --surface: #FAFAFA;
    --surface-alt: #F2F2F2;
    --border: #E0E0E0;
    --white: #FFFFFF;
    --code-bg: #1e1e2e;
    --code-fg: #cdd6f4;
    --code-comment: #6c7086;
    --code-string: #a6e3a1;
    --code-keyword: #cba6f7;
    --code-accent: #f9e2af;
    --success: #2D9F5C;
    --warning: #E89E0D;
    --danger: #D94040;
    --blue: #3B82F6;
    --blue-light: #EFF6FF;
    --purple: #7C3AED;
    --purple-light: #F5F3FF;
    --sidebar-w: 280px;
    --header-h: 64px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; scroll-padding-top: calc(var(--header-h) + 24px); }
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--surface); color: var(--ink); line-height: 1.72; font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }
  .header {
    position: fixed; top: 0; left: 0; right: 0; height: var(--header-h);
    background: var(--white); border-bottom: 1px solid var(--border);
    display: flex; align-items: center; padding: 0 32px; z-index: 100; gap: 16px;
  }
  .header-logo {
    width: 32px; height: 32px; background: var(--coral); border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 700; font-size: 14px; flex-shrink: 0;
  }
  .header-title { font-size: 16px; font-weight: 600; color: var(--ink); }
  .header-subtitle { font-size: 13px; color: var(--ink-muted); margin-left: auto; }
  .menu-toggle {
    display: none; background: none; border: none; cursor: pointer;
    width: 32px; height: 32px; flex-shrink: 0;
  }
  .menu-toggle span { display: block; width: 20px; height: 2px; background: var(--ink); margin: 4px auto; border-radius: 2px; }
  .progress-bar { position: fixed; top: var(--header-h); left: 0; right: 0; height: 3px; background: var(--border); z-index: 99; }
  .progress-fill { height: 100%; background: var(--coral); width: 0%; transition: width 0.1s linear; }
  .sidebar {
    position: fixed; top: calc(var(--header-h) + 3px); left: 0; bottom: 0;
    width: var(--sidebar-w); background: var(--white); border-right: 1px solid var(--border);
    overflow-y: auto; padding: 20px 0; z-index: 90; transition: transform 0.3s ease;
  }
  .sidebar::-webkit-scrollbar { width: 4px; }
  .sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
  .nav-section { padding: 0 16px; margin-bottom: 4px; }
  .nav-section-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: var(--ink-muted); padding: 10px 8px 4px; }
  .nav-link { display: block; padding: 5px 12px; font-size: 13px; color: var(--ink-light); text-decoration: none; border-radius: 6px; transition: all 0.15s; line-height: 1.35; }
  .nav-link:hover { background: var(--surface-alt); color: var(--ink); }
  .nav-link.active { background: var(--coral-light); color: var(--coral-dark); font-weight: 500; }
  .nav-link .nav-num { display: inline-block; width: 22px; font-size: 11px; color: var(--ink-muted); font-weight: 600; }
  .main { margin-left: var(--sidebar-w); margin-top: calc(var(--header-h) + 3px); min-height: calc(100vh - var(--header-h)); }
  .content { max-width: 760px; margin: 0 auto; padding: 48px 40px 120px; }
  .hero { text-align: center; padding: 64px 0 48px; border-bottom: 1px solid var(--border); margin-bottom: 48px; }
  .hero-badge { display: inline-block; background: var(--coral-light); color: var(--coral-dark); font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 20px; }
  .hero h1 { font-size: 38px; font-weight: 800; line-height: 1.15; color: var(--ink); margin-bottom: 16px; letter-spacing: -0.5px; }
  .hero h1 em { font-style: normal; color: var(--coral); }
  .hero p { font-size: 18px; color: var(--ink-light); max-width: 560px; margin: 0 auto; line-height: 1.6; }
  .hero-meta { display: flex; justify-content: center; gap: 24px; margin-top: 24px; font-size: 13px; color: var(--ink-muted); }
  hr.section-divider { border: none; border-top: 1px solid var(--border); margin: 56px 0 0; }
  h2 { font-size: 28px; font-weight: 750; color: var(--ink); margin: 56px 0 8px; padding-top: 16px; letter-spacing: -0.3px; line-height: 1.25; }
  h2 .section-num { color: var(--coral); font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 8px; }
  h3 { font-size: 20px; font-weight: 650; color: var(--ink); margin: 36px 0 12px; line-height: 1.3; }
  h4 { font-size: 16px; font-weight: 650; color: var(--ink); margin: 24px 0 8px; }
  p { margin-bottom: 16px; }
  strong { font-weight: 650; }
  .callout { border-radius: 10px; padding: 20px 24px; margin: 24px 0; font-size: 15px; line-height: 1.65; }
  .callout-title { font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
  .callout.insight { background: var(--coral-light); border-left: 4px solid var(--coral); }
  .callout.insight .callout-title { color: var(--coral-dark); }
  .callout.definition { background: #EEF2FF; border-left: 4px solid #6366F1; }
  .callout.definition .callout-title { color: #4338CA; }
  .callout.warning { background: #FFF8E6; border-left: 4px solid var(--warning); }
  .callout.warning .callout-title { color: #92600A; }
  .callout.success { background: #ECFDF5; border-left: 4px solid var(--success); }
  .callout.success .callout-title { color: #166534; }
  .callout.example { background: var(--surface-alt); border-left: 4px solid var(--ink-muted); }
  .callout.example .callout-title { color: var(--ink-light); }
  .callout.math { background: var(--purple-light); border-left: 4px solid var(--purple); }
  .callout.math .callout-title { color: var(--purple); }
  .callout.realworld { background: var(--blue-light); border-left: 4px solid var(--blue); }
  .callout.realworld .callout-title { color: #1D4ED8; }
  pre { background: var(--code-bg); color: var(--code-fg); border-radius: 10px; padding: 20px 24px; margin: 16px 0 24px; overflow-x: auto; font-family: 'JetBrains Mono', 'Fira Code', 'SF Mono', monospace; font-size: 13.5px; line-height: 1.65; }
  code { font-family: 'JetBrains Mono', 'Fira Code', 'SF Mono', monospace; font-size: 0.88em; }
  p code, li code, td code { background: var(--surface-alt); padding: 2px 6px; border-radius: 4px; color: var(--coral-dark); font-size: 0.85em; }
  .table-wrap { overflow-x: auto; margin: 16px 0 24px; border-radius: 10px; border: 1px solid var(--border); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th { background: var(--surface-alt); font-weight: 650; text-align: left; padding: 12px 16px; border-bottom: 2px solid var(--border); font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--ink-light); }
  td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--surface); }
  ul, ol { margin: 8px 0 20px; padding-left: 24px; }
  li { margin-bottom: 6px; padding-left: 4px; }
  li::marker { color: var(--ink-muted); }
  .score-scale { display: flex; flex-direction: column; gap: 8px; margin: 16px 0 24px; }
  .score-row { display: flex; gap: 12px; align-items: flex-start; font-size: 14px; }
  .score-num { flex-shrink: 0; width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; color: var(--white); }
  .score-num.s1 { background: var(--danger); }
  .score-num.s2 { background: #E87040; }
  .score-num.s3 { background: var(--warning); }
  .score-num.s4 { background: #6AB04C; }
  .score-num.s5 { background: var(--success); }
  .score-text { padding-top: 3px; line-height: 1.5; }
  .flow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 16px 0 24px; font-size: 14px; }
  .flow-step { background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 10px 16px; font-weight: 500; white-space: nowrap; }
  .flow-step.highlight { background: var(--coral-light); border-color: var(--coral); color: var(--coral-dark); }
  .flow-arrow { color: var(--ink-muted); font-size: 18px; flex-shrink: 0; }
  .maturity-card { border: 1px solid var(--border); border-radius: 12px; padding: 24px; margin: 16px 0; background: var(--white); position: relative; overflow: hidden; }
  .maturity-card::before { content: ''; position: absolute; top: 0; left: 0; bottom: 0; width: 4px; }
  .maturity-card.lvl0::before { background: var(--ink-muted); }
  .maturity-card.lvl1::before { background: var(--warning); }
  .maturity-card.lvl2::before { background: #6AB04C; }
  .maturity-card.lvl3::before { background: var(--success); }
  .maturity-card.lvl4::before { background: var(--coral); }
  .maturity-level { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
  .maturity-card.lvl0 .maturity-level { color: var(--ink-muted); }
  .maturity-card.lvl1 .maturity-level { color: var(--warning); }
  .maturity-card.lvl2 .maturity-level { color: #6AB04C; }
  .maturity-card.lvl3 .maturity-level { color: var(--success); }
  .maturity-card.lvl4 .maturity-level { color: var(--coral); }
  .maturity-name { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
  .maturity-desc { font-size: 14px; color: var(--ink-light); }
  .maturity-time { display: inline-block; margin-top: 10px; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 20px; background: var(--surface-alt); color: var(--ink-muted); }
  .vocab-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 16px 0 24px; }
  .vocab-card { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .vocab-term { font-weight: 700; font-size: 14px; margin-bottom: 4px; color: var(--ink); }
  .vocab-def { font-size: 13px; color: var(--ink-light); line-height: 1.5; }
  .commandment { display: flex; gap: 16px; margin: 16px 0; padding: 16px 20px; background: var(--white); border: 1px solid var(--border); border-radius: 10px; }
  .commandment-num { flex-shrink: 0; width: 36px; height: 36px; background: var(--ink); color: var(--white); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; }
  .commandment-body { flex: 1; }
  .commandment-rule { font-weight: 650; margin-bottom: 4px; }
  .commandment-why { font-size: 14px; color: var(--ink-light); }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 16px 0 24px; }
  .compare-col { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 20px; }
  .compare-col.bad { border-color: var(--danger); }
  .compare-col.good { border-color: var(--success); }
  .compare-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
  .compare-col.bad .compare-label { color: var(--danger); }
  .compare-col.good .compare-label { color: var(--success); }
  .compare-col p { font-size: 14px; margin-bottom: 8px; }
  .compare-col p:last-child { margin-bottom: 0; }
  .back-to-top { position: fixed; bottom: 32px; right: 32px; width: 44px; height: 44px; background: var(--ink); color: var(--white); border: none; border-radius: 50%; cursor: pointer; font-size: 20px; display: flex; align-items: center; justify-content: center; opacity: 0; transform: translateY(10px); transition: opacity 0.2s, transform 0.2s; z-index: 50; box-shadow: 0 2px 12px rgba(0,0,0,0.15); }
  .back-to-top.visible { opacity: 1; transform: translateY(0); }
  .back-to-top:hover { background: var(--coral); }
  .checklist { list-style: none; padding-left: 0; margin: 12px 0 24px; }
  .checklist li { padding: 8px 0 8px 32px; position: relative; font-size: 15px; border-bottom: 1px solid var(--surface-alt); }
  .checklist li::before { content: ''; position: absolute; left: 0; top: 10px; width: 18px; height: 18px; border: 2px solid var(--border); border-radius: 4px; }
  @media (max-width: 960px) {
    .sidebar { transform: translateX(-100%); }
    .sidebar.open { transform: translateX(0); box-shadow: 4px 0 24px rgba(0,0,0,0.1); }
    .main { margin-left: 0; }
    .content { padding: 32px 24px 120px; }
    .menu-toggle { display: block; }
    h2 { font-size: 24px; }
    .hero h1 { font-size: 30px; }
    .vocab-grid, .compare { grid-template-columns: 1fr; }
  }
  @media print {
    .sidebar, .header, .progress-bar, .back-to-top, .menu-toggle { display: none !important; }
    .main { margin-left: 0; margin-top: 0; }
    .content { max-width: 100%; padding: 0; }
    pre { white-space: pre-wrap; }
  }
</style>
